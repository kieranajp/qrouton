// qrouton's opinionated Zellij baseline. Generated into each session; edit the vendored asset.

keybinds clear-defaults=true {
    locked {
        // tmux is qrouton's deliberate Ctrl-g gateway, and the only way in.
        bind "Ctrl g" { SwitchToMode "tmux"; }
    }
    tmux {
        // There is deliberately no generic close binding. Zellij cannot make it
        // conditional on pane ownership, so exposing one would also let the
        // permanent agent, shell, dock, agent-status, or status panes be
        // removed. Transient panes own their own dismissal; shells close with
        // Ctrl-d, and quitting the configured editor closes its pane.
    }
    pane {
        bind "left" { MoveFocus "left"; }
        bind "down" { MoveFocus "down"; }
        bind "up" { MoveFocus "up"; }
        bind "right" { MoveFocus "right"; }
        bind "f" { ToggleFocusFullscreen; SwitchToMode "locked"; }
        bind "h" { MoveFocus "left"; }
        bind "j" { MoveFocus "down"; }
        bind "k" { MoveFocus "up"; }
        bind "l" { MoveFocus "right"; }
        bind "p" { SwitchToMode "locked"; }
        bind "w" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "z" { TogglePaneFrames; SwitchToMode "locked"; }
        bind "tab" { SwitchFocus; }
    }
    resize {
        bind "left" { Resize "Increase left"; }
        bind "down" { Resize "Increase down"; }
        bind "up" { Resize "Increase up"; }
        bind "right" { Resize "Increase right"; }
        bind "+" { Resize "Increase"; }
        bind "-" { Resize "Decrease"; }
        bind "=" { Resize "Increase"; }
        bind "H" { Resize "Decrease left"; }
        bind "J" { Resize "Decrease down"; }
        bind "K" { Resize "Decrease up"; }
        bind "L" { Resize "Decrease right"; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }
        bind "r" { SwitchToMode "locked"; }
    }
    scroll {
        bind "Alt left" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt down" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt up" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt right" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "e" { EditScrollback; SwitchToMode "locked"; }
        bind "f" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Alt h" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt j" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt k" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt l" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "s" { SwitchToMode "locked"; }
    }
    search {
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "n" { Search "down"; }
        bind "o" { SearchToggleOption "WholeWord"; }
        bind "p" { Search "up"; }
        bind "w" { SearchToggleOption "Wrap"; }
    }
    session {
        bind "d" { Detach; }
        bind "o" { SwitchToMode "locked"; }
    }
    shared_among "normal" "locked" {
        // User-created terminals stay inside the permanent shell stack. Run
        // initially places the pane near the current focus; `qrouton shell`
        // immediately joins it to the canonical right-hand stack using its
        // own ZELLIJ_PANE_ID, then starts the login shell.
        bind "Alt g" {
            Run "@@QROUTON_BIN@@" "shell" "--session-root" "@@SESSION_DIR@@" {
                cwd "@@SESSION_DIR@@"
                floating false
                stacked true
                name "shell"
                close_on_exit true
            }
        }
        // Escalation: float the repository picker over the live session at
        // generous geometry, keeping focus — the one deliberate exception to
        // spawn-returns-focus. @@SESSION_DIR@@ is substituted at stage time.
        bind "Alt e" {
            Run "@@QROUTON_BIN@@" "pick" "--session-root" "@@SESSION_DIR@@" {
                floating true
                x "20%"
                y "3%"
                width "60%"
                height "94%"
                name "escalate · Esc to cancel"
                close_on_exit true
            }
        }
        // Focus movement always restores locked mode, so wandering out of one
        // of the Ctrl-g gateway modes cannot leave the next keystroke bound to
        // something the user has forgotten about.
        bind "Alt left" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt down" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt up" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt right" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        bind "Alt +" "Alt Shift =" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt =" { Resize "Increase"; }
        bind "Alt f" { ToggleFloatingPanes; SwitchToMode "locked"; }
        bind "Alt h" { MoveFocusOrTab "left"; SwitchToMode "locked"; }
        bind "Alt j" { MoveFocus "down"; SwitchToMode "locked"; }
        bind "Alt k" { MoveFocus "up"; SwitchToMode "locked"; }
        bind "Alt l" { MoveFocusOrTab "right"; SwitchToMode "locked"; }
        // De-escalation: flip the session back to assistant; the supervisor
        // relaunches the runner with the conversation intact. Flags come before
        // the positional mode so the CLI parses them.
        bind "Alt n" {
            Run "@@QROUTON_BIN@@" "mode" "--session-root" "@@SESSION_DIR@@" "--shell-stack" "assistant" {
                cwd "@@SESSION_DIR@@"
                floating false
                stacked true
                name "shell"
                close_on_exit true
            }
        }
        // Cheap focus cycle. Panes are addressable by id (focus-pane-id), but
        // not by name, and a keybinding cannot run a CLI action without also
        // opening a pane for it — so a chord that jumps to "the agent" needs
        // the plugin API, not this file. Cycling is what a chord can do.
        bind "Alt tab" { SwitchFocus; SwitchToMode "locked"; }
        // Re-summons the quick-reference panel that greets the session at
        // startup — same global script, no Codex warning argument (that's a
        // launch-time-only concern). help.sh reads ./qrouton.json itself for
        // the mode tagline, so its cwd must be the session directory
        // explicitly: a Run block's default cwd follows the focused pane,
        // which may have wandered elsewhere in the shell.
        // Both spellings of the same chord: a terminal speaking the Kitty
        // keyboard protocol (Ghostty, Kitty, WezTerm) reports the unshifted
        // keycap plus Shift, so ? arrives as "Alt Shift /" and "Alt ?" alone
        // never fires. Every shifted Alt chord below needs the pair.
        bind "Alt ?" "Alt Shift /" {
            Run "sh" "@@HELP_SCRIPT@@" {
                cwd "@@SESSION_DIR@@"
                floating true
                x "15%"
                y "8%"
                width "70%"
                height "80%"
                name "keys · Esc to close"
                close_on_exit true
            }
        }
    }
    shared_except "locked" "renametab" "renamepane" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_except "locked" "entersearch" {
        bind "enter" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "renametab" "renamepane" {
        bind "esc" { SwitchToMode "locked"; }
    }
    shared_except "locked" "entersearch" "search" "renametab" "renamepane" "session" {
        bind "o" { SwitchToMode "session"; }
    }
    shared_among "normal" "resize" "scroll" "prompt" "tmux" {
        bind "p" { SwitchToMode "pane"; }
    }
    shared_among "normal" "resize" "search" "prompt" "tmux" {
        bind "s" { SwitchToMode "scroll"; }
    }
    shared_except "locked" "resize" "pane" "entersearch" "renametab" "renamepane" {
        bind "r" { SwitchToMode "resize"; }
    }
    shared_among "scroll" "search" {
        bind "PageDown" { PageScrollDown; }
        bind "PageUp" { PageScrollUp; }
        bind "left" { PageScrollUp; }
        bind "down" { ScrollDown; }
        bind "up" { ScrollUp; }
        bind "right" { PageScrollDown; }
        bind "Ctrl b" { PageScrollUp; }
        bind "Ctrl c" { ScrollToBottom; SwitchToMode "locked"; }
        bind "d" { HalfPageScrollDown; }
        bind "Ctrl f" { PageScrollDown; }
        bind "h" { PageScrollUp; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
        bind "l" { PageScrollDown; }
        bind "u" { HalfPageScrollUp; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    renametab {
        bind "esc" { UndoRenameTab; SwitchToMode "tab"; }
    }
    shared_among "renametab" "renamepane" {
        bind "Ctrl c" { SwitchToMode "locked"; }
    }
    renamepane {
        bind "esc" { UndoRenamePane; SwitchToMode "pane"; }
    }
}

// Plugin aliases - can be used to change the implementation of Zellij
// changing these requires a restart to take effect
plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

// Plugins to load in the background when a new session starts
// eg. "file:/path/to/my-plugin.wasm"
// eg. "https://example.com/my-plugin.wasm"
load_plugins {
    zellij:link
}
web_client {
    font "monospace"
}

// Options qrouton sets deliberately. Zellij's own commented-out documentation
// for every remaining option is upstream's to maintain, not ours — see
// `zellij setup --dump-config` for the annotated defaults.

// Locked by default: qrouton owns the chord scheme above, and an unlocked
// session would let Zellij's own single-key bindings swallow agent input.
default_mode "locked"

theme "catppuccin-macchiato"

// The layout is generated per session (see renderKDL); letting Zellij
// re-lay-out or resurrect panes would fight the staged layout.
auto_layout false
session_serialization false

// A launcher, not a harness: nothing should sit between the user and the
// agent on first attach.
show_startup_tips false
show_release_notes false

// Panes are the top-level primitive, so frames stay on — they carry the
// pane names and per-pane chord hints.
pane_frames true

// Mouse support: hover effects and click-through defaults are restated
// explicitly so an upstream default flip cannot silently change how focus
// moves between the agent and shell panes.
mouse_mode true
advanced_mouse_actions true
mouse_hover_effects true
focus_follows_mouse false
mouse_click_through false
