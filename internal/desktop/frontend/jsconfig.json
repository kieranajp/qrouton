{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "target": "ESNext",
    "module": "ESNext",
    "checkJs": true,
    "allowJs": true,
    "strict": false,
    "strictNullChecks": true,
    "types": [
      "vite/client",
      "node"
    ],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "/wails/runtime.js": [
        "src/types/wails-runtime.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.js",
    "src/**/*.d.ts",
    "src/**/*.svelte"
  ]
}
