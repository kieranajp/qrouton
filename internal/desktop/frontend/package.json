{
  "name": "qrouton-frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:share": "vite build --config vite.share.config.js",
    "check": "svelte-check --threshold warning",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test \"src/**/*.test.js\" \"eslint-rules/*.test.js\" \"scripts/*.test.js\"",
    "test:comments": "node --test eslint-rules/*.test.js scripts/*.test.js",
    "check:comments": "eslint --config eslint.config.js . && node scripts/comment-discipline-css.js",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@marp-team/marp-core": "5.0.1",
    "@sugar-high/remark": "^1.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sugar-high": "^2.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.1",
    "postcss": "^8.5.26",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "svelte-eslint-parser": "^1.8.1",
    "vite": "^8.2.1"
  }
}
